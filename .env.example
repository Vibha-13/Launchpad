# Copy this file to .env and fill in real values before running the app.

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If left unset in local/dev mode, app.py will generate a random key on each
# restart (fine for local dev, but sessions won't persist across restarts).
SECRET_KEY=

# Set to 1 to enable Flask's debug/reloader mode (auto-reload, interactive
# debugger). Leave unset or set to 0 in any shared/production environment.
FLASK_DEBUG=1

# Set to "production" to enforce the SECRET_KEY requirement above.
FLASK_ENV=development
